<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PathHide.App"
             Name="PathHide"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <!-- The surfaces, borders, and text change with the theme; each brush is defined in both
                 dictionaries and every consumer reaches it through DynamicResource (or the code-built
                 equivalent, ThemeResources.Themed), so a Save or an OS change repaints live. Each
                 pair keeps high contrast in both themes (ThemeResourcesTests). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F8FA"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE8"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2430"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#586070"/>
                    <!-- The scroll-bar thumb in the app's palette: every region here floats its bar,
                         which is the brush that one reads (app-chrome conventions). -->
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#586070"/>
                    <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#F8FAFC"/>
                    <SolidColorBrush x:Key="StatusBorderBrush" Color="#D8DEE8"/>
                    <SolidColorBrush x:Key="StatusAccentBrush" Color="#1D4ED8"/>
                    <SolidColorBrush x:Key="DangerTextBrush" Color="#DC2626"/>
                    <!-- Control surfaces: the secondary button and the fields rest on ControlBrush and
                         FieldBrush inside a ControlEdgeBrush edge; hover and press deepen the same
                         surface one step at a time. Rows and menu items fill with RowHoverBrush, and
                         the selected row with a tint of the app's blue. -->
                    <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#EEF2F7"/>
                    <SolidColorBrush x:Key="ControlPressedBrush" Color="#E1E7EF"/>
                    <SolidColorBrush x:Key="ControlEdgeBrush" Color="#B0B8C3"/>
                    <SolidColorBrush x:Key="ControlEdgeHoverBrush" Color="#959FAE"/>
                    <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="RowHoverBrush" Color="#F1F4F9"/>
                    <SolidColorBrush x:Key="RowPressedBrush" Color="#E6EBF2"/>
                    <SolidColorBrush x:Key="RowSelectedBrush" Color="#DDE7FD"/>
                    <SolidColorBrush x:Key="RowSelectedHoverBrush" Color="#D1DEFC"/>
                    <SolidColorBrush x:Key="FocusRingBrush" Color="#1D4ED8"/>
                    <!-- The same ring, desaturated and lightened toward the surface, for while the
                         window is inactive (interface-styling conventions). -->
                    <SolidColorBrush x:Key="FocusRingInactiveBrush" Color="#A7B4D6"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#121519"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1E24"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#323A46"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EAF0"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3ACBA"/>
                    <!-- The scroll-bar thumb in the app's palette: every region here floats its bar,
                         which is the brush that one reads (app-chrome conventions). -->
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#A3ACBA"/>
                    <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#161A1F"/>
                    <SolidColorBrush x:Key="StatusBorderBrush" Color="#323A46"/>
                    <SolidColorBrush x:Key="StatusAccentBrush" Color="#8AB4FF"/>
                    <SolidColorBrush x:Key="DangerTextBrush" Color="#F87171"/>
                    <SolidColorBrush x:Key="ControlBrush" Color="#232932"/>
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#2B323D"/>
                    <SolidColorBrush x:Key="ControlPressedBrush" Color="#343C48"/>
                    <SolidColorBrush x:Key="ControlEdgeBrush" Color="#5A6473"/>
                    <SolidColorBrush x:Key="ControlEdgeHoverBrush" Color="#788496"/>
                    <SolidColorBrush x:Key="FieldBrush" Color="#1A1E24"/>
                    <SolidColorBrush x:Key="RowHoverBrush" Color="#262C35"/>
                    <SolidColorBrush x:Key="RowPressedBrush" Color="#2B323D"/>
                    <SolidColorBrush x:Key="RowSelectedBrush" Color="#1D3157"/>
                    <SolidColorBrush x:Key="RowSelectedHoverBrush" Color="#233A66"/>
                    <SolidColorBrush x:Key="FocusRingBrush" Color="#8AB4FF"/>
                    <!-- The same ring, desaturated and darkened toward the surface, for while the
                         window is inactive (interface-styling conventions). -->
                    <SolidColorBrush x:Key="FocusRingInactiveBrush" Color="#4A5872"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Action fills: the same in both themes, each carrying white (or the About
                 foreground) text at 4.5:1 or more. -->
            <Color x:Key="Add">#047857</Color>
            <Color x:Key="AddHover">#065F46</Color>
            <Color x:Key="AddPressed">#064E3B</Color>
            <Color x:Key="Hide">#BE185D</Color>
            <Color x:Key="HideHover">#9D174D</Color>
            <Color x:Key="HidePressed">#831843</Color>
            <Color x:Key="Show">#6D28D9</Color>
            <Color x:Key="ShowHover">#5B21B6</Color>
            <Color x:Key="ShowPressed">#4C1D95</Color>
            <Color x:Key="Reload">#1D4ED8</Color>
            <Color x:Key="ReloadHover">#1E40AF</Color>
            <Color x:Key="ReloadPressed">#1E3A8A</Color>
            <Color x:Key="Reapply">#0E7490</Color>
            <Color x:Key="ReapplyHover">#155E75</Color>
            <Color x:Key="ReapplyPressed">#164E63</Color>
            <Color x:Key="Danger">#DC2626</Color>
            <Color x:Key="DangerHover">#B91C1C</Color>
            <Color x:Key="DangerPressed">#991B1B</Color>
            <Color x:Key="Cancel">#B45309</Color>
            <Color x:Key="CancelHover">#92400E</Color>
            <Color x:Key="CancelPressed">#78350F</Color>
            <Color x:Key="About">#4A044E</Color>
            <Color x:Key="AboutHover">#3B0764</Color>
            <Color x:Key="AboutForeground">#FFF7FE</Color>
            <Color x:Key="Utility">#374151</Color>
            <Color x:Key="UtilityHover">#1F2937</Color>
            <Color x:Key="UtilityPressed">#111827</Color>
            <Color x:Key="InactiveAction">#64748B</Color>

            <SolidColorBrush x:Key="AddBrush" Color="{StaticResource Add}"/>
            <SolidColorBrush x:Key="AddHoverBrush" Color="{StaticResource AddHover}"/>
            <SolidColorBrush x:Key="AddPressedBrush" Color="{StaticResource AddPressed}"/>
            <SolidColorBrush x:Key="HideBrush" Color="{StaticResource Hide}"/>
            <SolidColorBrush x:Key="HideHoverBrush" Color="{StaticResource HideHover}"/>
            <SolidColorBrush x:Key="HidePressedBrush" Color="{StaticResource HidePressed}"/>
            <SolidColorBrush x:Key="ShowBrush" Color="{StaticResource Show}"/>
            <SolidColorBrush x:Key="ShowHoverBrush" Color="{StaticResource ShowHover}"/>
            <SolidColorBrush x:Key="ShowPressedBrush" Color="{StaticResource ShowPressed}"/>
            <SolidColorBrush x:Key="ReloadBrush" Color="{StaticResource Reload}"/>
            <SolidColorBrush x:Key="ReloadHoverBrush" Color="{StaticResource ReloadHover}"/>
            <SolidColorBrush x:Key="ReloadPressedBrush" Color="{StaticResource ReloadPressed}"/>
            <SolidColorBrush x:Key="ReapplyBrush" Color="{StaticResource Reapply}"/>
            <SolidColorBrush x:Key="ReapplyHoverBrush" Color="{StaticResource ReapplyHover}"/>
            <SolidColorBrush x:Key="ReapplyPressedBrush" Color="{StaticResource ReapplyPressed}"/>
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
            <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHover}"/>
            <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource DangerPressed}"/>
            <SolidColorBrush x:Key="CancelBrush" Color="{StaticResource Cancel}"/>
            <SolidColorBrush x:Key="CancelHoverBrush" Color="{StaticResource CancelHover}"/>
            <SolidColorBrush x:Key="CancelPressedBrush" Color="{StaticResource CancelPressed}"/>
            <SolidColorBrush x:Key="AboutBrush" Color="{StaticResource About}"/>
            <SolidColorBrush x:Key="AboutHoverBrush" Color="{StaticResource AboutHover}"/>
            <SolidColorBrush x:Key="AboutForegroundBrush" Color="{StaticResource AboutForeground}"/>
            <SolidColorBrush x:Key="UtilityBrush" Color="{StaticResource Utility}"/>
            <SolidColorBrush x:Key="UtilityHoverBrush" Color="{StaticResource UtilityHover}"/>
            <SolidColorBrush x:Key="UtilityPressedBrush" Color="{StaticResource UtilityPressed}"/>
            <SolidColorBrush x:Key="InactiveActionBrush" Color="{StaticResource InactiveAction}"/>

            <!-- The app's sizes. One height for every standard control - each action button, each
                 dialog button, each one-line field - so a toolbar row and a footer line up. The
                 radius grows with the surface: rows and menu items, then controls, then the list's
                 frame. The focus ring sits 1px clear of a control and follows its corner. -->
            <x:Double x:Key="AppControlHeight">32</x:Double>
            <CornerRadius x:Key="AppRowRadius">6</CornerRadius>
            <CornerRadius x:Key="AppControlRadius">8</CornerRadius>
            <CornerRadius x:Key="AppSurfaceRadius">10</CornerRadius>
            <CornerRadius x:Key="AppControlFocusRadius">11</CornerRadius>
            <Thickness x:Key="AppFocusRingMargin">-3</Thickness>

            <!-- The app-wide UI (chrome) font. The default is the bundled Inter; the view model overrides
                 this resource at runtime from the configured UI font, and the Window style below binds it
                 via DynamicResource so the change applies live across every window. -->
            <!-- The collection URI, not the bare name: bare "Inter" falls back to the platform font. -->
            <FontFamily x:Key="AppFontFamily">fonts:Inter#Inter</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <!-- The toolkit's own accent - the checked box and radio, the text caret's selection -
                 is the app's blue rather than the operating system's, so nothing on screen wears a
                 colour the app did not choose. -->
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#1D4ED8"/>
                <ColorPaletteResources x:Key="Dark" Accent="#1D4ED8"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- Every window (main + dialogs) takes the configured UI font; FontFamily inherits to child
             controls. PathHide has no content/editing surface, so the UI font is the whole story. -->
        <!-- Both the family AND the size, set explicitly. With only the family, every label in
             the main window - the toolbar, the grid header and cells, the menu, the status bar -
             rendered at whatever the Fluent theme's default happened to be, so a theme update
             would resize the app's primary surface all at once and silently invalidate the chrome
             heights WindowMetrics reserves for it. 13 matches what the dialogs already state for
             their body text. -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- One button anatomy, whatever its colour: the standard height, symmetric padding with the
             label centred, the control radius, and no edge of its own unless its role draws one.
             Avalonia's stock button padding is lopsided (8,5,8,6), so leaving any of this unstated
             is the app failing to say what it wants rather than the toolkit getting it wrong.
             Anything still off after it is declared is the toolkit's, and is not to be chased with
             compensating values that would be wrong at the next font or size. -->
        <Style Selector="Button">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="{StaticResource AppControlHeight}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="{StaticResource AppControlRadius}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- One focus treatment for the whole app: a ring in the app's blue, 1px clear of the control
             and following its corner, that softens while the window is inactive (interface-styling
             conventions). Fluent's own is a square double outline 3px out, which hid the rounded
             corner and made the focused button look larger than its neighbour. The ring lies wholly
             outside the control, so it opts out of the adorner layer's clip to the control's bounds,
             which would otherwise leave only a sliver of its corner. The adorner is not a descendant
             the Window.windowInactive selector reliably reaches, so the inactive state is read
             directly off the owning window rather than through that class. -->
        <Style Selector="Button, CheckBox, RadioButton">
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border Classes="focusRing" Classes.inactive="{Binding !$parent[Window].IsActive}"
                            BorderThickness="2"
                            AdornerLayer.IsClipEnabled="False"
                            CornerRadius="{StaticResource AppControlFocusRadius}"
                            Margin="{StaticResource AppFocusRingMargin}"/>
                </FocusAdornerTemplate>
            </Setter>
        </Style>
        <Style Selector="Border.focusRing">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
        </Style>
        <Style Selector="Border.focusRing.inactive">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusRingInactiveBrush}"/>
        </Style>

        <!-- A square, icon-only button (the menu): as tall as every other control and as wide. -->
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="{StaticResource AppControlHeight}"/>
            <Setter Property="Height" Value="{StaticResource AppControlHeight}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- The quiet close mark on a result: compact, and exempt from the standard height, because
             it sits inside the result's own line rather than in a row of controls. -->
        <Style Selector="Button.resultClose">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <!-- The result's own vertical padding contains the larger pointer target. Removing
                 half of that target's excess from layout keeps a one-line message as the row's
                 height while the clickable area remains comfortably larger than the mark. -->
            <Setter Property="Margin" Value="0,-3"/>
            <Setter Property="CornerRadius" Value="{StaticResource AppRowRadius}"/>
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border Classes="focusRing" Classes.inactive="{Binding !$parent[Window].IsActive}"
                            BorderThickness="2"
                            AdornerLayer.IsClipEnabled="False"
                            CornerRadius="9"
                            Margin="{StaticResource AppFocusRingMargin}"/>
                </FocusAdornerTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.resultClose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.resultClose:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- The colour-coded action buttons are the app's own language and a recorded exception to
             the fleet's outlined destructive trigger: every action is a filled colour (add green,
             hide pink, show violet, reload blue, reapply teal, remove red, cancel amber), so
             outlining only the red one would break it. Each class states its fill, then a hover and
             a pressed step further down its own ladder. -->
        <Style Selector="Button.add">
            <Setter Property="Background" Value="{StaticResource AddBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.add:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AddHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.add:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AddPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.add:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AddBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.hide">
            <Setter Property="Background" Value="{StaticResource HideBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.hide:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HideHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.hide:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HidePressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.hide:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HideBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.show">
            <Setter Property="Background" Value="{StaticResource ShowBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.show:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ShowHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.show:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ShowPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.show:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ShowBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.reload">
            <Setter Property="Background" Value="{StaticResource ReloadBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.reload:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ReloadHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.reload:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ReloadPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.reload:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ReloadBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.reapply">
            <Setter Property="Background" Value="{StaticResource ReapplyBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.reapply:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ReapplyHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.reapply:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ReapplyPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.reapply:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ReapplyBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.destructive">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.destructive:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.destructive:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.destructive:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.cancel">
            <Setter Property="Background" Value="{StaticResource CancelBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.cancel:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CancelHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.cancel:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CancelPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.cancel:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CancelBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- About button -->
        <Style Selector="Button.about">
            <Setter Property="Background" Value="{StaticResource AboutBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AboutForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.about:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AboutHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AboutForegroundBrush}"/>
        </Style>

        <!-- Utility buttons: a dark-gray neutral (clearly not black) with a white icon/label — a
             deliberate dark control, without the near-black weight the hamburger originally had -->
        <Style Selector="Button.utility">
            <Setter Property="Background" Value="{StaticResource UtilityBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.utility:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource UtilityHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.utility:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource UtilityPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.utility:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource UtilityBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- The dialog's secondary action (Cancel, Close beside a commit): the app's own neutral
             control, a light surface inside a visible edge, stepping deeper on hover and press. Left
             to Fluent it was the toolkit's grey slab, and in the dark theme it lightened when
             pressed. -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.secondary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.secondary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Dialog accent button -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource ReloadBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- Fluent ships its own Button.accent, and its presenter setters outrank a
             button-level Background, so this class rested at the toolkit's system azure
             and only reached the app's blue once the pointer arrived. Said at presenter
             level, the resting fill is the app's again. -->
        <Style Selector="Button.accent /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ReloadBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ReloadHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ReloadPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ReloadBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- A dialog's primary action recedes while its dialog is not the active window, so the
             emphasis says which window the keyboard is in. DialogBase owns the windowInactive class;
             the neutral fill still reads as the primary beside the secondary's light surface. -->
        <Style Selector="Window.windowInactive Button.accent /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource InactiveActionBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- A disabled button is the resting button, faded: it keeps its own fill, ink and
             footprint, so it stays recognisably the control that will come back and the colour
             codes stay told apart while they are off. Left to Fluent, every class here — green,
             pink, violet, blue, teal, red, amber — resolved to the same grey slab, so a disabled
             Hide and a disabled Reload were one control. The fade is on the button, and every
             filled class restates its own fill above, so a red button stays red while it is off. -->
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <!-- A checkbox states the same as a button: its label is centred against the box.
             Left unstated it inherits the theme's own idea, which is not reliably centred. -->
        <Style Selector="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- One-line fields share the controls' height, radius and edge, and rest on the field
             surface. A field states that its text centres and that its padding is symmetric; if
             Avalonia's text layout still lands the line slightly off, that is the toolkit's, not
             something to chase with lopsided values. :is() so the IME-aware subclass takes it too. -->
        <Style Selector=":is(TextBox)">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="{StaticResource AppControlHeight}"/>
            <Setter Property="CornerRadius" Value="{StaticResource AppControlRadius}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeBrush}"/>
        </Style>
        <Style Selector=":is(TextBox):pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeHoverBrush}"/>
        </Style>
        <Style Selector=":is(TextBox):focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- The field's own focus edge softens while the window is inactive too (interface-styling
             conventions); DialogBase and MainWindow both own the windowInactive class. -->
        <Style Selector="Window.windowInactive :is(TextBox):focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusRingInactiveBrush}"/>
        </Style>

        <!-- The closed select matches the fields; the list it opens stays the toolkit's. -->
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="{StaticResource AppControlHeight}"/>
            <Setter Property="Padding" Value="10,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="{StaticResource AppControlRadius}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeHoverBrush}"/>
        </Style>
        <Style Selector="ComboBox:pressed /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlEdgeHoverBrush}"/>
        </Style>
        <!-- Fluent marks a keyboard-focused select by filling it with the accent; here it takes the
             fields' focus edge instead, so a focused select still reads as a field. -->
        <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
        </Style>
        <Style Selector="ComboBox:focus-visible /template/ ContentControl#ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <!-- The select's own focus edge softens while the window is inactive too (interface-styling
             conventions). -->
        <Style Selector="Window.windowInactive ComboBox:focus-visible /template/ Border#HighlightBackground">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusRingInactiveBrush}"/>
        </Style>
        <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <!-- The menu: the app's surface with its own edge, and inset, rounded item highlights
             rather than full-width bars. -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource AppSurfaceRadius}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem">
            <Setter Property="MinHeight" Value="{StaticResource AppControlHeight}"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem /template/ Border#PART_LayoutRoot">
            <Setter Property="CornerRadius" Value="{StaticResource AppRowRadius}"/>
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem:pressed /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource RowPressedBrush}"/>
        </Style>

        <!-- The path list reads as items: no rules between rows or cells, a quiet header of
             secondary labels over one line, and rows whose hover and selection are rounded fills
             in the app's own colours rather than the toolkit's full-width system-accent bar. -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <!-- The header keeps its dividers, which mark where a column can be resized, drawn in
                 the app's hairline rather than the toolkit's translucent black. -->
            <Setter Property="SeparatorBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style Selector="DataGridColumnHeader /template/ Border#HeaderBorder">
            <Setter Property="CornerRadius" Value="{StaticResource AppRowRadius}"/>
        </Style>
        <Style Selector="DataGridColumnHeader:pointerover /template/ Border#HeaderBorder">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
        </Style>
        <Style Selector="DataGridColumnHeader:pressed /template/ Border#HeaderBorder">
            <Setter Property="Background" Value="{DynamicResource RowPressedBrush}"/>
        </Style>
        <Style Selector="DataGrid /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
            <Setter Property="Fill" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style Selector="DataGridRow /template/ Rectangle#BackgroundRectangle">
            <Setter Property="RadiusX" Value="6"/>
            <Setter Property="RadiusY" Value="6"/>
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource RowHoverBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource RowSelectedBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource RowSelectedHoverBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Keep DataGrid cell navigation active without drawing a harsh current-cell box. Fluent
             outlines the focused cell in white, which reads as a second selection inside the row
             the user actually selected (composite-control conventions). -->
        <Style Selector="DataGridCell">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

    </Application.Styles>
</Application>
