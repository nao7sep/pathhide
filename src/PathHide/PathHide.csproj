<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Required by the LibraryImport source generator (see Services/MacFs.cs),
         which emits unsafe marshalling stubs internally. Windows directory identity also pins its native output buffer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows: embeds icon.ico into the .exe. macOS uses macOS/icon.icns (classic,
         CFBundleIconFile) and macOS/Assets.car (Liquid Glass, CFBundleIconName) instead;
         staged into the .app by the AssembleMacAppBundle target. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyTitle>PathHide</AssemblyTitle>
    <Description>Hide chosen files and folders in one step, show them again when you need them, and reapply the visibility you set.</Description>
    <!-- No osx-x64. The fleet ships Apple Silicon only (app-release-conventions),
         and nothing published it: package.sh publishes osx-arm64 and package.ps1
         win-x64. Listing it made restore fetch three osx-x64 runtime packs nobody
         ships, and kept alive a local rebuild path that would build and launch an
         Intel binary the project does not produce. -->
    <RuntimeIdentifiers>osx-arm64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- The interface languages ship inside the assembly, so a catalogue cannot be separated from the
         build that was tested against it and a language change never reads the disk. The logical name
         is the default one, PathHide.I18n.Locales.<tag>.json (see I18n/Catalogue.cs). -->
    <EmbeddedResource Include="I18n\Locales\*.json" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <!-- DataGrid is published separately; 12.1.2 is its latest release. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <!-- Avalonia 12.1 declares SkiaSharp 3.119 as its floor but supports SkiaSharp 4 when an app
         references it directly; Avalonia 13 is expected to raise the floor. The direct reference brings
         the current Skia engine and its macOS and Windows native assets. HarfBuzzSharp stays at
         Avalonia's own version: upstream has not declared its new major compatible. -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- SQLite binding for the write-through data-backup store (Backup/BackupStore.cs). The ADO.NET
         provider bundles SQLitePCLRaw's native library, so it needs no separate native rebuild and adds no
         packaging churn on a runtime bump (data-backup conventions: lowest-friction SQLite binding). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Microsoft.Data.Sqlite's floor is still SQLitePCLRaw 2.1.x (2.1.12 at 10.0.12, past the 2.1.11
         advisory GHSA-2m69-gcr7-jv3q). A direct top-level reference overrides it (direct wins) so the app
         ships the current 3.x bundle and its newer native SQLite. Drop it once Microsoft.Data.Sqlite's
         own floor reaches the current SQLitePCLRaw release. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>
</Project>
