<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PathHide.ViewModels"
        xmlns:i18n="using:PathHide.I18n"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="PathHide.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PathHide"
        Icon="/Assets/icon.png"
        Width="1280" Height="720"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Styles>
        <Style Selector="Border.pathReceiver.dropActive">
            <Setter Property="BorderBrush" Value="{StaticResource ReloadBrush}"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
        <Style Selector="Border.pathResult">
            <Setter Property="Background" Value="{DynamicResource StatusBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StatusAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
        <Style Selector="Border.pathResult.warning">
            <Setter Property="BorderBrush" Value="{StaticResource CancelBrush}"/>
        </Style>
        <Style Selector="Border.pathResult.error">
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        </Style>
    </Window.Styles>

    <DockPanel x:Name="LayoutRoot">

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                x:Name="Toolbar"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel>
                <!-- Hamburger menu (right-aligned) -->
                <Button DockPanel.Dock="Right"
                        Classes="utility"
                        Padding="8,2"
                        VerticalAlignment="Stretch"
                        x:Name="MenuButton"
                        i18n:Localized.AutomationName="menu.button"
                        i18n:Localized.ToolTip="menu.button">
                    <!-- Hamburger drawn as a vector (three equal strokes) rather than the
                         ☰ glyph, whose strokes render with uneven weight across fonts. Bars 16
                         long and 2 thick with 5 between them: closer together they read as one
                         block rather than a menu, and the round caps stay inside the 18x16 box. -->
                    <Path Width="18" Height="16"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          UseLayoutRounding="True"
                          Data="M1,1 H17 M1,8 H17 M1,15 H17"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <!-- Key set in code: it reveals rather than opens (LogReveal runs
                                 `open -R` / `explorer /select,`), and it names the running
                                 platform's file browser. "Open Log File" sent a user expecting
                                 to read the log to a Finder window instead. -->
                            <MenuItem x:Name="OpenLogMenuItem"/>
                            <MenuItem i18n:Localized.Header="menu.settings"
                                      x:Name="SettingsMenuItem"/>
                            <MenuItem i18n:Localized.Header="menu.shortcuts" x:Name="ShortcutsMenuItem"/>
                            <MenuItem i18n:Localized.Header="menu.about" x:Name="AboutMenuItem"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Action buttons (left, single row — never wrap. Wrapping made the rows
                     touch and doubled the hamburger's height; instead the window minimum
                     reserves the toolbar's full width so a second line never happens. -->
                <StackPanel Orientation="Horizontal"
                            x:Name="ActionButtons"
                            i18n:Localized.AutomationName="toolbar.actions"
                            KeyboardNavigation.TabNavigation="Once">
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
                        <Button i18n:Localized.Content="toolbar.addFiles" Classes="add" x:Name="AddFilesButton"/>
                        <Button i18n:Localized.Content="toolbar.addDirectories" Classes="add" x:Name="AddFoldersButton"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
                        <Button i18n:Localized.Content="toolbar.hideAll" Classes="hide" Command="{Binding HideAllCommand}"/>
                        <Button i18n:Localized.Content="toolbar.hideSelected" Classes="hide" Command="{Binding HideSelectedCommand}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
                        <Button i18n:Localized.Content="toolbar.showAll" Classes="show" Command="{Binding ShowAllCommand}"/>
                        <Button i18n:Localized.Content="toolbar.showSelected" Classes="show" Command="{Binding ShowSelectedCommand}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
                        <Button i18n:Localized.Content="toolbar.reload" Classes="reload" Command="{Binding ReloadCommand}"/>
                        <Button i18n:Localized.Content="toolbar.reapplyAll" Classes="reapply" Command="{Binding ReapplyAllCommand}"/>
                        <!-- Remove is wired in code-behind (not Command-bound) so it shares the
                             grid's post-delete selection recovery with the Delete key. -->
                        <Button i18n:Localized.Content="common.remove" Classes="destructive" x:Name="RemoveButton"/>
                        <Button i18n:Localized.Content="common.cancel" Classes="cancel"
                                Command="{Binding CancelCommand}"
                                IsVisible="{Binding IsBusy}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                x:Name="StatusBar"
                Background="{DynamicResource StatusBackgroundBrush}"
                BorderBrush="{DynamicResource StatusBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Panel>
                <TextBlock Text="{Binding ProgressText}"
                           IsVisible="{Binding IsScanning}"
                           Foreground="{DynamicResource StatusAccentBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusBarText}"
                           IsVisible="{Binding !IsScanning}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </Panel>
        </Border>

        <!-- Operational problems are independent from the transient status bar. A routine success
             can update the bar without erasing this dismissible result. -->
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding OperationalResults}"
                      IsVisible="{Binding HasOperationalResults}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:OperationalResultViewModel">
                    <Border Classes="pathResult" Classes.error="{Binding IsError}"
                            AutomationProperties.Name="{Binding Text}"
                            AutomationProperties.LiveSetting="{Binding LiveSetting}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Classes="resultClose" VerticalAlignment="Top"
                                    Command="{Binding $parent[ItemsControl].DataContext.DismissOperationalResultCommand}"
                                    CommandParameter="{Binding}" i18n:Localized.AutomationName="common.closeResult"
                                    i18n:Localized.ToolTip="common.close">
                                <Path Width="10" Height="10" Stroke="{Binding $parent[Button].Foreground}"
                                      StrokeThickness="1.6" StrokeLineCap="Round"
                                      Data="M1,1 L9,9 M9,1 L1,9"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Path list -->
        <Border x:Name="PathListReceiver" Classes="pathReceiver" Margin="12" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}"
                ClipToBounds="True" DragDrop.AllowDrop="True">
            <DockPanel>
                <Border x:Name="PathAddResultSurface"
                        DockPanel.Dock="Bottom" Classes="pathResult"
                        Classes.warning="{Binding PathAddResult.IsWarning}"
                        Classes.error="{Binding PathAddResult.IsError}"
                        IsVisible="{Binding HasPathAddResult}"
                        AutomationProperties.Name="{Binding PathAddResult.Text}"
                        AutomationProperties.LiveSetting="{Binding PathAddResult.LiveSetting}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding PathAddResult.Text}" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Classes="resultClose" VerticalAlignment="Top"
                                Command="{Binding DismissPathAddResultCommand}"
                                i18n:Localized.AutomationName="common.closeResult" i18n:Localized.ToolTip="common.close">
                            <Path Width="10" Height="10" Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1.6" StrokeLineCap="Round"
                                  Data="M1,1 L9,9 M9,1 L1,9"/>
                        </Button>
                    </Grid>
                </Border>
                <Grid>
                <DataGrid x:Name="PathGrid"
                          i18n:Localized.AutomationName="grid.name"
                          ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          SelectionMode="Extended"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="{DynamicResource SurfaceBrush}">
                    <DataGrid.Columns>
                        <!-- Each column carries a real minimum width; WindowMetrics sums these
                             (read from the live columns) to derive the window's MinWidth, so the
                             window and its columns can never drift apart. Headers are set in code
                             (MainWindow.ApplyColumnHeaders): a column is not a visual, so it cannot
                             tell whether its window is still open when the language changes. Each
                             state column shows its words and sorts by its value, so a column keeps
                             its order whatever language is showing. The state columns are as wide
                             as their longest word in any interface language needs, with the room a
                             header keeps for its sort arrow (LabelFitTests measures every one). -->
                        <DataGridTextColumn Binding="{Binding Path}" SortMemberPath="Path" Width="*" MinWidth="240"/>
                        <DataGridTextColumn Binding="{Binding PathFamilyText}" SortMemberPath="PathFamily" Width="100" MinWidth="100"/>
                        <DataGridTextColumn Binding="{Binding DesiredVisibilityText}" SortMemberPath="DesiredVisibility" Width="110" MinWidth="110"/>
                        <DataGridTextColumn Binding="{Binding ActualStateText}" SortMemberPath="ActualState" Width="155" MinWidth="155"/>
                        <DataGridTextColumn Binding="{Binding ItemKindText}" SortMemberPath="ItemKind" Width="160" MinWidth="160"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock i18n:Localized.Text="grid.empty"
                           IsVisible="{Binding IsPathListEmpty}" IsHitTestVisible="False"
                           Margin="24,48,24,24" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </DockPanel>
        </Border>

    </DockPanel>
</Window>
