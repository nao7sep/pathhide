<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PathHide.Views.DialogBase"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">

    <!-- Two bands, because the OS title bar is the header (modal-dialog conventions). Each band carries
         its own padding: the body's is inside the scroll region, so the region fills the band and its
         bar sits at the dialog's edge rather than against a control. A margin here instead would leave
         a gap where the bar should start. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom"
                    x:Name="ButtonPanel"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    Margin="24,20,24,20"/>

        <!-- The line that opens the footer band, and the bottom edge of the scrolling body. -->
        <Border DockPanel.Dock="Bottom"
                x:Name="FooterSeparator"
                Height="1"
                Background="{DynamicResource BorderBrush}"/>

        <!-- The sole scroll region. The footer is docked outside it, so it stays reachable at any
             height the dialog is bounded to. -->
        <ScrollViewer x:Name="DialogScroll"
                      AllowAutoHide="True"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ContentPresenter x:Name="DialogContent" Margin="24"/>
        </ScrollViewer>
    </DockPanel>

</Window>
