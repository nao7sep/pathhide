<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PathHide.Views.DialogBase"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">

    <DockPanel Margin="24">
        <!-- Button row at the bottom -->
        <StackPanel DockPanel.Dock="Bottom"
                    x:Name="ButtonPanel"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0"/>

        <!-- Content area. The body is the sole scroll region, under a height
             bounded to the screen (see OnOpened): the footer is docked, so an
             unbounded body pushes it off-screen instead of scrolling, and this
             shell is CanResize="False" — there would be no way to get it back.
             The shortcuts dialog already measures close to a small laptop's
             working height, and startup/recovery copy can legitimately wrap. -->
        <ScrollViewer x:Name="DialogScroll"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ContentPresenter x:Name="DialogContent"/>
        </ScrollViewer>
    </DockPanel>

</Window>
