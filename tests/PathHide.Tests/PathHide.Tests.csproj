<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- xUnit v3 test projects are executables (their own in-process runner). -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <!-- The host app is a WinExe; referencing it warns about the mismatch. The
         test host is a console app and only consumes the produced assembly. -->
    <NoWarn>$(NoWarn);NU1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Avalonia.Headless.XUnit 12.1.3 is built against xUnit 3.2.2 and still calls the
         GetTestCaseDetails overload removed in xUnit 4. Keep the framework pinned until
         Avalonia updates its discovery and runner integration. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Official xUnit headless integration ([AvaloniaFact]); depends on xunit.v3. Lets the
         scan-lifecycle tests run on a real dispatcher/UI thread, matching how the view model
         marshals scan progress in the app. -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PathHide\PathHide.csproj" />
  </ItemGroup>
</Project>
