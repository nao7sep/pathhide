<Project Sdk="Microsoft.NET.Sdk">
  <!-- Development only: opens the real Records window over throwaway records (see Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <!-- The app is a WinExe; referencing it warns about the mismatch. -->
    <NoWarn>$(NoWarn);NU1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PathHide\PathHide.csproj" />
  </ItemGroup>
</Project>
