<Project>

  <!-- Shared metadata and language settings for every project in the solution.
       Project-specific values (OutputType, AssemblyTitle, package references)
       live in each .csproj. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Every project builds without warnings, so a warning introduced later fails the build,
         the release build included, instead of scrolling past. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Authors>Yoshinao Inoguchi</Authors>
    <Company>$(Authors)</Company>
    <Product>PathHide</Product>
    <Copyright>Copyright © 2026 $(Authors)</Copyright>
    <Version>0.1.0</Version>
    <!-- One Avalonia release for the app and its headless tests; DataGrid ships on its own schedule. -->
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
  </PropertyGroup>

</Project>
